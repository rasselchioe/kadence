# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server actions only — never expose to client

# ── Database (drizzle-kit reads this directly) ──────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Open-Meteo — no key needed; flag to disable enrichment ──────────────────
KADENCE_WEATHER_ENABLED=true

# ── Maps ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# ── Optional, later ─────────────────────────────────────────────────────────
OPENROUTESERVICE_KEY=
MAPBOX_TOKEN=
